KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_TRUSTSTORE_LOCATION=certificates/kafka.truststore.p12
KAFKA_TRUSTSTORE_PASSWORD=changeit
KAFKA_KEYSTORE_LOCATION=certificates/kafka.client.keystore.p12
KAFKA_KEYSTORE_PASSWORD=changeit
KAFKA_KEY_PASSWORD=changeit

# Okta application (client) credentials — copy from Admin → Applications.
# Kafka ACL principals stay payment-producer / payment-consumer when you add the azp claim (docs/OKTA.md).
PAYMENT_API_CLIENT_ID=0oa00000000000000000
PAYMENT_API_CLIENT_SECRET=
KAFKA_PRODUCER_CLIENT_ID=0oa00000000000000001
KAFKA_PRODUCER_CLIENT_SECRET=
KAFKA_CONSUMER_CLIENT_ID=0oa00000000000000002
KAFKA_CONSUMER_CLIENT_SECRET=
KAFKA_BROKER_CLIENT_ID=0oa00000000000000003
KAFKA_BROKER_CLIENT_SECRET=

# Two Okta custom authorization servers — two audiences. Do not share one issuer.
# HTTP resource server (aud=payment-api)
OAUTH_ISSUER_URI=https://dev-123456.okta.com/oauth2/ausPaymentApiId
OAUTH_TOKEN_ENDPOINT=https://dev-123456.okta.com/oauth2/ausPaymentApiId/v1/token
OAUTH_API_AUDIENCE=payment-api

# Kafka SASL/OAUTHBEARER (aud=kafka)
KAFKA_OAUTH_ISSUER_URI=https://dev-123456.okta.com/oauth2/ausKafkaId
KAFKA_OAUTH_TOKEN_ENDPOINT=https://dev-123456.okta.com/oauth2/ausKafkaId/v1/token
KAFKA_OAUTH_JWKS_ENDPOINT=https://dev-123456.okta.com/oauth2/ausKafkaId/v1/keys

# Broker principal claim. Default azp requires the custom access-token claim in docs/OKTA.md.
# Set to cid if you skip that claim and put 0oa… ids in create-acls.sh principals.
OAUTH_PRINCIPAL_CLAIM=azp
